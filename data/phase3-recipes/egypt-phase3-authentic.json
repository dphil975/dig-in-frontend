      "name": "Tamiya (Fava Bean Fritters)",
      "difficulty": "Medium",
      "servings": 12,
      "prepTime": 10,
      "cookTime": 20,
      "description": "Crispy Egyptian fritters made from fava beans and herbs",
      "seasonings": [
        "parsley",
        "cilantro",
        "cumin"
      ],
      "ingredients": [
        "2 cups dried fava beans (soaked)",
        "1 onion, chopped",
        "1 cup parsley",
        "1/2 cup cilantro",
        "3 cloves garlic",
        "1 tsp cumin",
        "1 tsp coriander",
        "Flour",
        "Oil for frying",
        "Salt"
      ],
      "instructions": [
        "Drain soaked beans",
        "Grind beans with herbs, onion, garlic",
        "Add spices",
        "Add enough flour to hold together",
        "Form into small patties",
        "Heat oil to 350°F",
        "Fry until golden on both sides",
        "Drain on paper towels",
        "Serve in pita with tahini sauce"
      ],
      "notes": "Use dried fava beans, not canned",
      "fun_fact": "Tamiya is the Egyptian version of falafel and is eaten throughout the region",
      "alternatives": [
        "Add chickpeas",
        "Different herbs",
        "Baked instead of fried"
      ]
