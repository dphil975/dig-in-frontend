  "dinner": [
    {
      "id": "egy-dinner-molokhia",
      "name": "Molokhia (Green Stew)",
      "difficulty": "Medium",
      "servings": 6,
      "prepTime": 20,
      "cookTime": 40,
      "description": "Egyptian stew with leafy greens and meat in broth",
      "seasonings": [
        "garlic",
        "coriander"
      ],
      "ingredients": [
        "1 lb molokhia (or spinach)",
        "1.5 lbs lamb or chicken",
        "6 cups broth",
        "8 cloves garlic",
        "2 tbsp coriander",
        "2 tbsp oil",
        "Lemon juice",
        "Salt"
      ],
      "instructions": [
        "Bring broth to boil with meat",
        "Simmer 20 minutes until tender",
        "Remove meat, cut into pieces",
        "Add meat back to broth",
        "Finely chop molokhia",
        "Add to broth, stir constantly",
        "Add crushed garlic and coriander",
        "Simmer 15 minutes, stirring often",
        "Add lemon juice",
        "Serve over rice"
      ],
      "notes": "Must stir constantly to prevent clumping",
      "fun_fact": "Molokhia is Cleopatra's favorite dish - has been eaten in Egypt for thousands of years",
      "alternatives": [
        "Vegetarian with chickpeas",
        "Add tomato",
        "Use chard instead of molokhia"
      ]
    }
  ],
