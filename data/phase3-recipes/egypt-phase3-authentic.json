      "id": "egy-break-fuul-medames",
      "name": "Fuul Medames (Fava Beans)",
      "difficulty": "Easy",
      "servings": 4,
      "prepTime": 10,
      "cookTime": 10,
      "description": "Stewed fava beans with garlic, lemon, and olive oil",
      "seasonings": [
        "garlic",
        "cumin",
        "lemon"
      ],
      "ingredients": [
        "2 cans fava beans (or soaked dried)",
        "4 cloves garlic, minced",
        "1/4 cup olive oil",
        "2 tbsp lemon juice",
        "1 tsp cumin",
        "Salt",
        "Pepper",
        "Hard-boiled eggs"
      ],
      "instructions": [
        "Heat olive oil in pan",
        "Sauté garlic until fragrant",
        "Add fava beans with some liquid",
        "Warm through, 5-10 minutes",
        "Mash some beans but leave some whole",
        "Add lemon juice and cumin",
        "Season with salt and pepper",
        "Transfer to serving bowl",
        "Drizzle with more olive oil",
        "Top with hard-boiled eggs"
      ],
      "notes": "Can use fresh or canned beans",
      "fun_fact": "Fuul is the national dish of Egypt and eaten for breakfast by millions daily",
      "alternatives": [
        "Add tomatoes",
        "More garlic",
        "Include onions"
      ]
    }
  ],
