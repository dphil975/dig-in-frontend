      "description": "Egyptian street food combining rice, lentils, pasta, and tomato sauce",
      "seasonings": [
        "cumin",
        "garlic"
      ],
      "ingredients": [
        "1 cup cooked rice",
        "1 cup cooked brown lentils",
        "1 cup cooked short pasta",
        "2 cups tomato sauce",
        "1 can chickpeas",
        "4 cloves garlic, minced",
        "Vinegar",
        "Cumin",
        "Crispy onions"
      ],
      "instructions": [
        "Cook rice, lentils, and pasta separately",
        "Mix garlic into tomato sauce",
        "Heat chickpeas",
        "Layer rice in bowl",
        "Top with lentils and pasta",
        "Pour tomato sauce over",
        "Sprinkle crispy onions",
        "Drizzle with vinegar",
        "Serve hot"
      ],
      "notes": "Each component should be slightly seasoned separately",
      "fun_fact": "Koshari is Egypt's national fast food and is the most popular street food in Cairo",
      "alternatives": [
        "More vegetables mixed in",
        "Different pastas",
        "Add fried chicken"
      ]
    }
