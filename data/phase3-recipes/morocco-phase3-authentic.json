  "dinner": [
    {
      "id": "mor-dinner-tagine",
      "name": "Moroccan Chicken Tagine (Braised Chicken with Preserved Lemons and Olives)",
      "difficulty": "Medium",
      "servings": 4,
      "prepTime": 20,
      "cookTime": 60,
      "description": "Braised chicken with preserved lemons and olives - Moroccan dinner classic",
      "seasonings": [
        "turmeric",
        "cumin",
        "cinnamon",
        "paprika",
        "saffron",
        "ginger"
      ],
      "ingredients": [
        "1.2kg chicken thighs, bone-in, skin-on",
        "2 onions, thinly sliced",
        "4 cloves garlic, minced",
        "2 tablespoons ginger, minced",
        "2 preserved lemons (or 1 fresh lemon), quartered",
        "200g green olives, pitted",
        "1 teaspoon turmeric powder",
        "1 teaspoon cumin powder",
        "1/2 teaspoon ginger powder",
        "1/2 teaspoon paprika",
        "Pinch of saffron",
        "1/2 teaspoon cinnamon",
        "3 tablespoons fresh cilantro, chopped",
        "3 tablespoons fresh parsley, chopped",
        "300ml chicken stock",
        "3 tablespoons olive oil",
        "Salt and pepper to taste"
      ],
      "instructions": [
        "Season chicken with salt and pepper",
        "Heat olive oil in tagine pot or large heavy-bottomed skillet over medium-high heat",
        "Brown chicken on all sides (8-10 minutes total); remove and set aside",
        "Reduce heat to medium; add onions, cook until softened (5 minutes)",
        "Add garlic and minced ginger; cook 1 minute",
        "Add turmeric, cumin, ginger powder, paprika, cinnamon; cook 2 minutes until fragrant",
        "Return chicken to pot",
        "Add preserved lemon, olives, saffron, cilantro, parsley",
        "Pour in chicken stock",
        "Cover and simmer on low heat 40-50 minutes until chicken is very tender",
        "Taste and adjust seasonings",
        "Serve over couscous or with bread for soaking sauce"
      ],
      "notes": "Preserved lemons (or noomi) are signature Moroccan ingredient where lemons are cured in salt for weeks",
      "fun_fact": "Preserved lemons create an earthy complexity impossible to replicate with fresh lemon juice",
      "alternatives": [
        "Use fish instead of chicken",
        "Add dried apricots",
        "Make with lamb",
        "Add almonds"
      ],
