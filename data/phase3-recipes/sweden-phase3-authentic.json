        "salt",
        "pepper"
      ],
      "ingredients": [
        "2 lbs salmon fillet",
        "3 tbsp salt",
        "2 tbsp sugar",
        "1 tbsp black pepper",
        "1 tbsp coriander seeds",
        "1 bunch fresh dill",
        "For sauce: 1/4 cup Dijon mustard",
        "1 tbsp honey",
        "2 tbsp olive oil",
        "1 tbsp dill"
      ],
      "instructions": [
        "Mix salt, sugar, pepper, coriander",
        "Place dill in bottom of dish",
        "Rub salt mixture on salmon",
        "Layer more dill over salmon",
        "Cover with plastic wrap",
        "Place weight on top",
        "Cure in refrigerator 3-7 days",
        "Slice thin at angle to the skin",
        "Make sauce: mix mustard, honey, oil, dill",
        "Serve with toast and sauce"
      ],
      "notes": "Patience is essential - curing takes days",
      "fun_fact": "Gravlax dates back to medieval Swedish fishing traditions",
      "alternatives": [
