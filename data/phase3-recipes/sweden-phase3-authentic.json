      "name": "Swedish Meatballs",
      "difficulty": "Medium",
      "servings": 4,
      "prepTime": 20,
      "cookTime": 30,
      "description": "Small tender meatballs in creamy gravy with lingonberry sauce",
      "seasonings": [
