      ],
      "ingredients": [
        "1.5 lbs ground beef",
        "1/2 cup breadcrumbs",
        "1/4 cup milk",
        "1 egg",
        "1 onion, minced",
        "1/4 tsp nutmeg",
        "Black pepper",
        "2 tbsp butter",
        "1 cup broth",
        "1/2 cup cream",
        "2 tbsp lingonberry jam"
      ],
      "instructions": [
        "Soak breadcrumbs in milk",
        "Mix with ground beef, egg, onion, nutmeg, pepper",
        "Form into 1-inch balls",
        "Brown in butter in batches",
        "Set aside",
        "Make gravy: whisk flour into butter drippings",
        "Add broth slowly",
        "Simmer 5 minutes",
        "Add cream and lingonberry jam",
        "Return meatballs to gravy",
        "Simmer 10 minutes",
        "Serve with lingonberry sauce"
      ],
      "notes": "Must be tender, don't overwork meat",
      "fun_fact": "Swedish Meatballs are served at Christmas and are known worldwide from IKEA",
