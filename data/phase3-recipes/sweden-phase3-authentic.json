        "pepper"
      ],
      "ingredients": [
        "1 loaf white bread",
        "1/2 lb ham",
        "1/2 lb roast beef",
        "1/2 lb shrimp",
        "1 cup cheese",
        "2 hard-boiled eggs",
        "1 cup mayonnaise",
        "2 tbsp gelatin",
        "2 cups broth",
        "Cucumber",
        "Tomato"
      ],
      "instructions": [
        "Slice bread horizontally to make 4-5 layers",
        "Spread mayonnaise on each layer",
        "Layer ham on first",
        "Layer roast beef on second",
        "Layer cheese on third",
        "Layer shrimp on fourth",
        "Cut into rectangular block",
        "Make aspic: dissolve gelatin in warm broth",
        "Cool until syrupy",
        "Frost cake with aspic",
        "Decorate with sliced eggs, cucumber, tomato",
        "Refrigerate until set"
      ],
      "notes": "Must be chilled and set before serving",
      "fun_fact": "Smörgåstårta is a Swedish party centerpiece and special occasion dish",
      "alternatives": [
