      "seasonings": [
        "curry powder",
        "bay leaf"
      ],
      "ingredients": [
        "2 cups ground egusi seeds",
        "1.5 lbs meat/fish",
        "1 large onion",
        "8 cups water",
        "2 cups leafy greens (spinach)",
        "2 tbsp palm oil",
        "3 cloves garlic",
        "2 tbsp cayenne",
        "Curry powder",
        "Bay leaf",
        "Salt"
      ],
      "instructions": [
        "Heat palm oil in pot",
        "Sauté onion and garlic",
        "Add meat and brown",
        "Add water and bay leaf",
        "Simmer meat until tender (20 min)",
        "Mix egusi seeds with some broth to dissolve",
        "Pour egusi mixture slowly into soup, stirring constantly",
        "Add curry and cayenne",
        "Simmer 20 minutes",
        "Add leafy greens",
        "Cook 5 more minutes",
        "Season to taste"
      ],
      "notes": "Egusi must be thoroughly dissolved",
      "fun_fact": "Egusi Soup is a staple at Nigerian celebrations and gatherings",
