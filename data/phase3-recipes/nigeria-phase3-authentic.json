      "id": "nig-break-jollof-rice",
      "name": "Jollof Rice",
      "difficulty": "Medium",
      "servings": 6,
      "prepTime": 15,
      "cookTime": 35,
      "description": "Nigerian rice cooked in tomato sauce with spices and vegetables",
      "seasonings": [
        "paprika",
        "cayenne",
        "bay leaf",
        "curry"
      ],
      "ingredients": [
        "2 cups rice",
        "3 tomatoes (or can)",
        "1 onion",
        "4 cloves garlic",
        "1/4 cup tomato paste",
        "1/4 cup oil",
        "4 cups broth",
        "1 red pepper",
        "Paprika",
        "Cayenne",
        "Curry powder",
        "Bay leaf",
        "Salt"
      ],
      "instructions": [
        "Heat oil, sauté onion and garlic",
        "Add tomato paste, cook 2 minutes",
        "Blend tomatoes and red pepper, add to pot",
        "Cook 5 minutes",
        "Add broth and seasonings",
        "Bring to boil",
        "Add rice, stir well",
        "Cover, simmer 20-25 minutes until rice is tender",
        "Let rest 5 minutes",
        "Fluff and serve"
      ],
      "notes": "The key is cooking on high heat then low, and not stirring too much",
      "fun_fact": "Jollof Rice is beloved across West Africa and each country claims the best version",
      "alternatives": [
        "Add chicken or shrimp",
        "Less spicy version",
        "Add mixed vegetables"
      ]
    }
