      "name": "Rendang (Spiced Coconut Meat)",
      "difficulty": "Hard",
      "servings": 6,
      "prepTime": 20,
      "cookTime": 90,
      "description": "Indonesian rich curry with beef and coconut milk cooked until oil separates",
      "seasonings": [
        "turmeric",
        "galangal",
        "lemongrass",
        "chili"
      ],
      "ingredients": [
        "2 lbs beef, cubed",
        "2 cans coconut milk",
        "8 shallots",
        "6 cloves garlic",
        "1-inch turmeric",
        "2-inch galangal",
        "6 red chilies",
        "4 stalks lemongrass",
        "Salt",
        "Sugar"
      ],
      "instructions": [
        "Blend shallots, garlic, turmeric, galangal, chilies, lemongrass",
        "Heat paste in pot with oil",
        "Cook 3 minutes until fragrant",
        "Add beef, stir 5 minutes",
        "Add coconut milk",
        "Simmer 60-90 minutes on low heat",
        "Stir occasionally",
        "When oil separates from sauce (meat is dark), it's done",
        "Taste and adjust seasoning"
      ],
      "notes": "Slow cooking is essential",
      "fun_fact": "Rendang is consistently voted world's best dish and is Indonesia's national dish",
      "alternatives": [
        "Chicken instead of beef",
        "Less spicy version",
        "Add potatoes"
      ]
    }
  ],
