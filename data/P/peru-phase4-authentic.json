      "name": "Empanada (Filled Pastry)",
      "difficulty": "Hard",
      "servings": 12,
      "prepTime": 30,
      "cookTime": 30,
      "description": "Peruvian fried pastry filled with meat",
      "seasonings": [
        "cumin",
        "garlic"
      ],
      "ingredients": [
        "Dough: 3 cups flour, 1 tsp salt, 1/2 cup butter, 3/4 cup water",
        "Filling: 1 lb ground beef, 1 onion, 4 cloves garlic, Cumin, Olives, Raisins",
        "Oil for frying"
      ],
      "instructions": [
        "Make dough: mix flour and salt, cut in butter, add water",
        "Knead until smooth, rest 20 minutes",
        "Brown meat with onion and garlic",
        "Add cumin, olives, raisins",
        "Cool filling",
        "Roll dough thin",
        "Cut circles",
        "Fill each with meat",
        "Fold and seal edges",
        "Deep fry until golden",
        "Drain on paper towels"
      ],
      "notes": "Filling must be cool",
      "fun_fact": "Empanadas are popular street food throughout Peru and Latin America",
      "alternatives": [
        "Cheese filling",
        "Baked instead of fried",
        "Different shaped"
      ],
