      "name": "Quinoa Breakfast Bowl",
      "difficulty": "Easy",
      "servings": 2,
      "prepTime": 5,
      "cookTime": 20,
      "description": "Ancient Andean grain with fruits and nuts",
      "seasonings": [
        "cinnamon"
      ],
      "ingredients": [
        "1 cup quinoa",
        "2 cups water",
        "1 banana, sliced",
        "1/2 cup berries",
        "1/4 cup almonds",
        "Honey",
        "Cinnamon",
        "Milk"
      ],
      "instructions": [
        "Rinse quinoa",
        "Boil water with salt",
        "Add quinoa",
        "Cover and simmer 15 minutes",
        "Fluff with fork",
        "Transfer to bowl",
        "Top with banana and berries",
        "Sprinkle almonds",
        "Drizzle honey",
        "Dust with cinnamon",
        "Serve with milk"
      ],
      "notes": "Quinoa is complete protein",
      "fun_fact": "Quinoa is an ancient Andean superfood and has been cultivated in Peru for thousands of years",
      "alternatives": [
