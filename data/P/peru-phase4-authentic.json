  "dinner": [
    {
      "id": "per-dinner-lomo",
      "name": "Lomo Saltado (Stir-Fried Beef)",
      "difficulty": "Medium",
      "servings": 4,
      "prepTime": 15,
      "cookTime": 15,
      "description": "Peruvian stir-fried beef with tomatoes and potatoes",
      "seasonings": [
        "garlic",
        "soy sauce",
        "cumin"
      ],
      "ingredients": [
        "1.5 lbs beef sirloin, cut into strips",
        "3 tomatoes, cut into wedges",
        "2 red onions, thick sliced",
        "4 cloves garlic",
        "3 tbsp soy sauce",
        "2 tbsp vinegar",
        "3 tbsp oil",
        "Cilantro",
        "Boiled potatoes"
      ],
      "instructions": [
        "Heat oil in wok or large pan",
        "Add beef, cook until brown",
        "Remove beef",
        "Add onions, cook until slightly soft",
        "Add garlic, cook 1 minute",
        "Add tomatoes",
        "Return beef",
        "Add soy sauce and vinegar",
        "Toss everything together 2-3 minutes",
        "Season with salt and pepper",
        "Garnish with cilantro",
        "Serve with boiled potatoes"
      ],
      "notes": "Must be cooked quickly on high heat",
      "fun_fact": "Lomo Saltado is Peru's national stir-fry and combines Chinese and Peruvian influences",
      "alternatives": [
        "Chicken instead of beef",
        "Add potatoes to the wok",
        "More sauce"
      ],
      "image": "https://upload.wikimedia.org/wikipedia/commons/f/ff/LomoSaltado2.jpg",
      "imageCredit": {
        "author": "Dtarazona",
        "source": "Wikimedia Commons",
        "license": "CC BY-SA 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:LomoSaltado2.jpg"
      }
    }
  ],
  "snacks": [
