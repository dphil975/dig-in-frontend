  "lunch": [
    {
      "id": "per-lunch-ceviche",
      "name": "Ceviche (Lime-Cured Fish)",
      "difficulty": "Medium",
      "servings": 4,
      "prepTime": 30,
      "cookTime": 0,
      "description": "Peruvian raw fish cured in lime juice with chilies",
      "seasonings": [
        "chili",
        "lime",
        "cilantro"
      ],
      "ingredients": [
        "1.5 lbs white fish, cubed",
        "1 cup lime juice",
        "1 red onion, sliced thin",
        "3 hot peppers",
        "1/2 cup cilantro",
        "Sweet potato",
        "Corn kernels",
        "Salt"
      ],
      "instructions": [
        "Cube raw fish into 1-inch pieces",
        "Combine fish with lime juice",
        "Add sliced onion",
        "Let sit 15-30 minutes (fish will 'cook')",
        "Fish should be opaque",
        "Chop peppers, add with cilantro",
        "Season with salt",
        "Serve with boiled sweet potato and corn",
        "Serve with plantain chips"
      ],
      "notes": "Fish must be very fresh",
      "fun_fact": "Ceviche is Peru's national dish and was invented by coastal Peruvian fishermen",
      "alternatives": [
        "Shrimp instead of fish",
        "Different peppers",
        "Add avocado"
      ],
      "image": "https://upload.wikimedia.org/wikipedia/commons/1/1b/Ceviche_de_pescado_%28La_Punta%2C_Callao%29.jpg",
