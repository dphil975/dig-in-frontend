  "desserts": [
    {
      "id": "per-dessert-flan",
      "name": "Flan (Caramel Custard)",
      "difficulty": "Medium",
      "servings": 8,
      "prepTime": 15,
      "cookTime": 45,
      "description": "Peruvian creamy custard with caramel",
      "seasonings": [
        "vanilla"
      ],
      "ingredients": [
        "1 cup sugar (for caramel)",
        "6 eggs",
        "1 can condensed milk",
        "1 can evaporated milk",
        "1 tbsp vanilla",
        "Pinch salt"
      ],
      "instructions": [
        "Preheat oven to 350°F",
        "Melt 1/2 cup sugar in saucepan over medium heat",
        "When caramel forms, pour into flan dish, coating bottom",
        "Blend eggs, condensed milk, evaporated milk, vanilla, salt",
        "Pour into caramel-lined dish",
        "Place in water bath",
        "Bake 40-45 minutes until set but slightly jiggly",
        "Cool completely",
        "Refrigerate overnight",
        "Run knife around edge, invert onto plate"
      ],
      "notes": "Don't overbake",
      "fun_fact": "Flan is beloved throughout Spanish America and is Peru's classic dessert",
      "alternatives": [
        "Add coconut",
        "Different milk ratios",
        "Caramel sauce on top"
      ],
      "image": "https://upload.wikimedia.org/wikipedia/commons/a/a4/CremeCaramelPrd.jpg",
      "imageCredit": {
