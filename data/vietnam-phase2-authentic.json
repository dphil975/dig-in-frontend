      "difficulty": "Hard",
      "servings": 4,
      "prepTime": 20,
      "cookTime": 180,
      "description": "Aromatic beef broth with rice noodles and tender beef, Vietnam's most iconic breakfast",
      "seasonings": [
        "star anise",
        "cinnamon",
        "coriander",
        "clove",
        "ginger"
      ],
      "ingredients": [
        "2 lbs beef bones",
        "1 lb beef brisket",
        "2 inches ginger",
        "1 onion",
        "4 star anise",
        "1 cinnamon stick",
        "1 tbsp coriander seeds",
        "3 cloves",
        "2 tbsp fish sauce",
        "1 tbsp sugar",
        "10 cups water",
        "1 lb fresh rice noodles",
