    "glutenFreeVeganRecipes": [
      {
        "id": "recipe_001",
        "name": "Gluten-Free Vegan Black Bean Burgers",
        "servings": "4 patties",
        "ingredients": [
          "1 can (15 oz) black beans, drained and mashed",
          "1/2 cup cooked rice or quinoa",
          "1/4 cup ground flaxseed",
          "1/4 cup sautéed mushrooms (finely chopped)",
          "2 tbsp tamari or soy sauce",
          "1 tbsp maple syrup",
          "1 tsp cumin",
          "1/2 tsp black pepper",
          "Gluten-free breadcrumbs (1/4 cup, if needed for binding)"
        ],
        "instructions": [
          "Mix all ingredients in a bowl",
          "Form into 4 patties (refrigerate 30 minutes)",
          "Pan-fry in oil over medium-high heat",
          "Cook 4-5 minutes per side until golden",
          "Serve on gluten-free buns with toppings"
        ],
        "nutritionPerPatty": "Protein: 12g | Fat: 6g | Carbs: 24g | Fiber: 6g"
      },
      {
        "id": "recipe_002",
        "name": "Gluten-Free Vegan Pasta Primavera",
        "servings": "4",
        "ingredients": [
          "8 oz gluten-free pasta",
          "2 cups mixed vegetables (zucchini, bell pepper, carrots, peas)",
          "4 cloves garlic, minced",
          "3 tbsp olive oil",
          "Juice of 1 lemon",
          "Salt and pepper to taste",
          "2 tbsp nutritional yeast",
          "Fresh basil for garnish"
        ],
        "instructions": [
          "Cook gluten-free pasta according to package directions",
          "Sauté vegetables in olive oil until tender-crisp",
          "Add garlic and cook 1 minute",
          "Toss pasta with vegetables, lemon juice, and seasonings",
          "Top with nutritional yeast and fresh basil"
        ],
        "note": "Nutritional yeast adds cheesy flavor and B vitamins"
      },
      {
        "id": "recipe_003",
        "name": "Gluten-Free Vegan Chocolate Brownies",
        "servings": "12",
        "ingredients": [
          "1 cup gluten-free flour blend",
          "1/2 cup cocoa powder",
          "1 tsp xanthan gum (if not in flour blend)",
          "1/2 tsp baking powder",
          "1/4 tsp sea salt",
          "3/4 cup coconut sugar",
          "1/2 cup coconut oil (melted)",
          "1/3 cup unsweetened almond milk",
          "2 flax eggs (2 tbsp ground flax + 6 tbsp water, rested)",
          "1 tsp vanilla extract",
          "1/2 cup vegan chocolate chips"
        ],
        "instructions": [
          "Preheat oven to 350°F, grease 8x8 pan",
          "Mix dry ingredients (flour, cocoa, xanthan gum, baking powder, salt)",
          "Whisk wet ingredients (oil, milk, flax eggs, vanilla)",
          "Combine wet and dry, fold in chocolate chips",
          "Bake 25-30 minutes until a toothpick comes out with fudgy crumbs",
          "Cool completely before cutting"
        ],
        "texture": "Fudgy and moist"
      }
