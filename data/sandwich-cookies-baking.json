        "difficulty": "Beginner",
        "yield": "12 sandwich cookies (24 shells)",
        "ingredients": [
          "2 1/4 cups flour",
          "2 tablespoons cocoa powder",
          "1/2 teaspoon baking soda",
          "1/4 teaspoon salt",
          "1/2 cup butter",
          "3/4 cup sugar",
          "1 egg",
          "1 teaspoon vanilla"
        ],
        "instructions": [
          "Cream butter and sugar",
          "Add egg and vanilla",
          "Mix flour, cocoa, baking soda, salt",
          "Combine dry and wet ingredients",
          "Chill 1 hour",
          "Roll between parchment to 1/4 inch",
          "Cut with cookie cutter",
          "Bake at 350°F for 8-10 minutes",
          "Cool completely",
          "Sandwich with buttercream or ganache"
        ]
      },
