    "sandwichCookieRecipes": [
      {
        "id": "recipe_001",
        "name": "Classic Vanilla Macarons",
        "difficulty": "Advanced",
        "yield": "20 sandwich cookies (40 shells)",
        "shells": {
          "ingredients": [
            "100g almond flour",
            "100g powdered sugar",
            "2 egg whites",
            "25g sugar",
            "1/4 teaspoon vanilla extract"
          ],
          "instructions": [
            "Combine almond flour and powdered sugar",
            "Sift 3 times (removes lumps)",
            "Whip egg whites until foamy",
            "Gradually add sugar while beating",
            "Beat to stiff peaks (shiny)",
            "Fold in almond mixture until ribbon-like consistency",
            "Pipe onto lined baking sheet",
            "Rest 15-30 minutes",
            "Bake at 325°F for 12-15 minutes"
          ]
        },
        "filling": "French Buttercream (4 oz butter, 2 oz white chocolate, 1 tablespoon milk, vanilla)"
      },
      {
