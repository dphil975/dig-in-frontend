      {
        "id": "cub-bf-4",
        "name": "Cafecito (Cuban Espresso with Espuma)",
        "difficulty": "Easy",
        "servings": 4,
        "prepTime": 5,
        "cookTime": 5,
        "ingredients": [
          "4 shots dark-roast espresso",
          "4 tsp sugar (demerara or white)",
          "A small amount of the first drops of espresso"
        ],
        "instructions": [
          "Begin brewing espresso in a moka pot",
          "Immediately catch the first few drops of espresso in a cup with the sugar",
          "Beat the sugar and initial espresso drops vigorously with a spoon — whip until it becomes a light brown, creamy paste (espuma/espumita)",
          "This step is everything — the foam must be thick and pale",
          "Pour the rest of the brewed coffee over the espuma",
          "The foam rises to the top, creating a sweet, crema-like layer",
          "Pour into small tacitas (demitasse cups)",
          "This is not optional sweetness — the espuma IS the cafecito"
        ],
        "description": "The Cuban coffee ritual — the secret is the espuma, a whipped sugar-and-espresso foam made from the first drops of coffee beaten with sugar until creamy. The whipping technique went viral and changed how people outside Cuba think about sweetened coffee. Every ventanita in Miami keeps the tradition alive.",
        "image": "https://upload.wikimedia.org/wikipedia/commons/9/9b/Cuban_coffee-_2013-04-05_14-30.jpg",
        "imageCredit": {
          "author": "Wikimedia Commons",
          "source": "Wikimedia Commons",
          "license": "CC BY-SA 4.0",
          "url": "https://upload.wikimedia.org/wikipedia/commons/9/9b/Cuban_coffee-_2013-04-05_14-30.jpg"
