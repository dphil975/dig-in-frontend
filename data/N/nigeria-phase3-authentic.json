      "id": "nga-dinner-egusi-soup",
      "name": "Egusi Soup (Melon Seed Soup)",
      "difficulty": "Medium",
      "servings": 4,
      "prepTime": 20,
      "cookTime": 45,
      "description": "Nigerian melon seed soup with beef and vegetables - rich and satisfying",
      "seasonings": [
        "palm oil",
        "grains of paradise",
        "salt"
      ],
      "ingredients": [
        "200g egusi (melon seeds), ground",
        "500g beef, cubed",
        "200g spinach or bitter leaf, chopped",
        "1 onion, diced",
        "3 cloves garlic, minced",
        "100ml palm oil",
        "1 liter beef stock",
        "2 Maggi cubes",
        "1 scotch bonnet pepper, whole",
        "1 teaspoon grains of paradise (alligator pepper), ground",
        "Salt and pepper to taste"
      ],
      "instructions": [
        "Brown beef in pot with diced onion and minced garlic until no longer pink",
        "Add palm oil, stir for 1 minute",
        "Add beef stock and Maggi cubes",
        "Bring to boil, then simmer 20 minutes until beef is tender",
        "Mix ground egusi (melon seeds) with 1 cup water to form paste",
        "Add egusi paste to boiling stock, stirring well to avoid lumps",
        "Add whole scotch bonnet pepper",
        "Simmer 15 minutes, stirring occasionally",
        "Add chopped spinach or bitter leaf",
        "Add grains of paradise",
        "Simmer 5 more minutes",
        "Season with salt and pepper",
        "Remove scotch bonnet pepper before serving",
        "Serve with fufu, pounded yam, or rice"
      ],
      "notes": "Egusi must be well-ground and mixed with water to prevent lumps",
      "fun_fact": "Egusi Soup is eaten throughout West Africa with regional variations",
