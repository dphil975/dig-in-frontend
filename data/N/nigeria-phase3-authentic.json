    {
      "id": "nga-lunch-jollof-rice",
      "name": "Jollof Rice (West African Spiced Rice)",
      "difficulty": "Medium",
      "servings": 4,
      "prepTime": 20,
      "cookTime": 40,
      "description": "Iconic West African lunch - spiced rice with tomato base. Different countries compete over who makes best version",
      "seasonings": [
        "thyme",
        "bay leaf",
        "ginger"
      ],
      "ingredients": [
        "500g rice",
        "800g tomatoes (fresh or canned)",
        "1 onion",
        "3 cloves garlic",
        "3 tbsp tomato paste",
        "200ml chicken broth",
        "100ml oil",
        "1 tsp ginger",
        "1 red bell pepper",
        "Salt and pepper to taste",
        "Thyme",
        "Bay leaf"
      ],
      "instructions": [
        "Blend tomatoes, onion, garlic and bell pepper",
        "Heat oil, fry blended mixture and tomato paste for 10 minutes until oil rises",
        "Add ginger, thyme, bay leaf, cook 2 minutes",
        "Rinse rice, add to pot, stir to coat with tomato mixture",
        "Add broth, bring to boil",
        "Reduce heat to low, cover, cook 20-25 minutes until rice is tender",
        "Remove bay leaf, season with salt and pepper"
      ],
      "notes": "Oil must rise to top after frying for best flavor. Rice should be separate grains, not mushy",
      "fun_fact": "Jollof Rice is iconic West African dish, different countries compete over who makes best version. Popular lunch everywhere",
      "alternatives": [
        "Add chicken or beef",
