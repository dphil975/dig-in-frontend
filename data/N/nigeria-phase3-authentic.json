      "id": "nga-dinner-jollof",
      "name": "Nigerian Jollof Rice (West African Spiced Red Rice)",
      "difficulty": "Medium",
      "servings": 4,
      "prepTime": 30,
      "cookTime": 40,
      "description": "West African spiced red rice - pan-West African dinner classic",
      "seasonings": [
        "paprika",
        "Scotch bonnet pepper"
      ],
      "ingredients": [
        "500g long-grain parboiled rice",
        "4 medium red bell peppers",
        "2 Scotch bonnet peppers (or habanero)",
        "400g canned crushed tomatoes",
        "3 medium tomatoes, fresh",
        "2 onions, divided",
        "4 cloves garlic",
        "2 tablespoons ginger",
        "100ml vegetable oil",
        "750ml chicken or vegetable broth",
        "2 Maggi cubes or chicken bouillon cubes",
        "1 teaspoon paprika",
        "Salt and pepper to taste",
        "2 bay leaves",
        "Fresh parsley for garnish"
      ],
      "instructions": [
        "Blend red peppers, Scotch bonnets, fresh tomatoes, 1 onion, garlic, ginger into puree",
        "Heat oil in large pot over medium heat",
        "Dice remaining onion; fry until soft (3-4 minutes)",
        "Add blended pepper mixture; cook 20-30 minutes until sauce thickens and turns brick-red",
        "Oil should separate at edges",
        "Break crumbled Maggi cubes into mixture",
        "Add canned tomatoes; cook 5 minutes",
        "Add paprika; stir well",
        "Rinse rice thoroughly in warm water; drain well",
        "Add rice to pot; stir to coat with sauce (2-3 minutes)",
        "Add broth and bay leaves; stir once",
        "Bring to boil; reduce heat to low, cover tightly",
        "Cook 20-25 minutes until rice fluffy and liquid absorbed",
        "Do not stir after liquid added",
        "Taste and adjust salt and pepper",
        "Garnish with fresh parsley"
      ],
      "notes": "Sauce must cook until deeply brick-red color",
