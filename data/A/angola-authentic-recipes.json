      {
        "id": "ago-ln-4",
        "name": "Muamba de Galinha (Angolan Chicken Stew)",
        "difficulty": "Medium",
        "servings": 6,
        "prepTime": 20,
        "cookTime": 50,
        "ingredients": [
          "1 whole chicken (cut into pieces)",
          "Palm oil (dendê)",
          "Okra",
          "Tomatoes, onion, garlic",
          "Chili peppers (gindungo)",
          "Palm butter (muamba paste)",
          "Garlic, ginger",
          "Salt",
          "Funge (cassava flour porridge) for serving"
        ],
        "instructions": [
          "Season and brown chicken pieces in palm oil",
          "Sauté onion, garlic, ginger",
          "Add tomatoes, cook down into sauce",
          "Add palm butter/muamba paste — this makes it rich and orange-red",
          "Add water, bring to simmer",
          "Add chicken back, simmer 40 min until tender",
          "Add okra and chili in last 10 min",
          "The sauce should be thick, coating the chicken in a glossy orange-red layer",
          "Serve with funge — smooth cassava porridge that scoops up the sauce",
          "Angola's version of the great Central/West African palm butter stew"
        ],
        "description": "Angola's national dish — chicken in a rich palm butter and chili sauce with okra. The deep orange-red color and the communal funge-scooping technique have made muamba de galinha viral as one of Africa's greatest stews. Similar to Congo's poulet moambé but with Angola's signature gindungo chili heat.",
        "image": "https://upload.wikimedia.org/wikipedia/commons/f/fa/Poulet_%C3%A0_la_moambe.JPG",
        "imageCredit": {
          "author": "Wikimedia Commons",
          "source": "Wikimedia Commons",
          "license": "CC BY-SA 4.0",
          "url": "https://upload.wikimedia.org/wikipedia/commons/f/fa/Poulet_%C3%A0_la_moambe.JPG"
        }
      }
