    {
      "id": "bgd-break-paratha",
      "name": "Paratha (Layered Bread)",
      "difficulty": "Medium",
      "servings": 4,
      "prepTime": 20,
      "cookTime": 20,
      "description": "Bangladeshi flatbread with layers and butter",
      "seasonings": [
        "salt"
      ],
      "ingredients": [
        "2 cups flour",
        "1 tsp salt",
        "3/4 cup water",
        "4 tbsp ghee or butter",
        "Extra ghee for brushing"
      ],
      "instructions": [
        "Mix flour and salt with water to make dough",
        "Knead until smooth",
        "Let rest 30 minutes",
        "Divide into 4 balls",
        "Roll each thin",
        "Brush with ghee",
        "Fold in half, brush again",
        "Fold again",
        "Coil into spiral",
        "Roll out thin",
        "Cook on griddle until golden and layered",
        "Brush with more ghee",
        "Serve hot"
      ],
      "notes": "Must develop layers through folding",
      "fun_fact": "Paratha is Bangladesh's most popular breakfast bread eaten daily",
      "alternatives": [
        "Potato-filled paratha",
        "Different shape",
        "Less ghee version"
      ],
      "image": "https://upload.wikimedia.org/wikipedia/commons/4/41/Lachha-paratha.jpg",
