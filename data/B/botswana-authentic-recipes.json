        "name": "Bogobe (Sorghum Porridge)",
        "difficulty": "Easy",
        "servings": 4,
        "prepTime": 5,
        "cookTime": 20,
        "ingredients": [
          "2 cups sorghum flour",
          "4 cups water",
          "1 tsp salt",
          "Milk",
          "Sugar or honey"
        ],
        "instructions": [
