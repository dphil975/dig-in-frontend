      {
        "id": "bwa-ln-3",
        "name": "Dikgobe (Bean and Corn Stew)",
        "difficulty": "Easy",
        "servings": 6,
        "prepTime": 15,
        "cookTime": 60,
        "ingredients": [
          "2 cups samp (dried corn kernels, soaked)",
          "1 cup sugar beans or cowpeas (soaked)",
          "Salt",
          "Water"
        ],
        "instructions": [
          "Cook soaked samp in plenty of water, 45 min until almost tender",
          "Add soaked beans",
          "Continue cooking until both are soft and creamy",
          "Season with salt",
          "The starch makes the broth thick and silky",
          "Serve as main dish or side"
        ],
        "description": "Beans and samp simmered together — Botswana's everyday comfort food. Simple, filling, nourishing."
      },
      {
        "id": "bwa-ln-4",
        "name": "Seswaa (Pounded Beef)",
        "difficulty": "Medium",
        "servings": 6,
        "prepTime": 15,
        "cookTime": 240,
        "ingredients": [
          "1kg beef (bone-in, fatty cuts preferred — brisket, shin)",
          "Water",
          "Salt",
          "Bones for extra flavor"
        ],
        "instructions": [
          "Place beef and bones in large pot",
          "Cover with water — just enough, not too much",
          "Bring to boil, then reduce to low simmer",
          "Cook 3-4 hours until meat falls off the bone",
          "Remove bones",
          "Shred and pound meat with a wooden spoon or fork until it's a soft, fibrous mass",
          "Season with salt only — no other spices, this is about pure beef flavor",
          "Serve with pap (stiff maize porridge) and a side of morogo (wild greens)",
          "This is Botswana's celebration dish — weddings, funerals, national holidays all center on seswaa"
        ],
        "description": "Botswana's national dish — slow-boiled beef pounded into tender shreds, served with pap. The simplicity is the point: just meat, water, salt, and time. Went viral when food explorers showed the communal cooking and pounding tradition at Batswana celebrations.",
        "image": "https://upload.wikimedia.org/wikipedia/commons/d/da/Seswaa.jpg",
        "imageCredit": {
          "author": "Kalanga",
          "source": "Wikimedia Commons",
          "license": "CC BY-SA 3.0",
          "url": "https://commons.wikimedia.org/wiki/File%3ASeswaa.jpg"
        }
      }
