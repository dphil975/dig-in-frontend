        "difficulty": "Easy",
        "servings": 4,
        "prepTime": 5,
        "cookTime": 20,
        "ingredients": [
          "2 cups cassava flour",
          "4 cups water",
          "Salt"
        ],
        "instructions": [
          "Boil water with salt",
          "Gradually stir in cassava flour",
          "Stir constantly for 15 min until thick",
          "Serve warm with beans or greens"
