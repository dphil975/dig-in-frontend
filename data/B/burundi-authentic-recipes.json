      {
        "id": "bdi-ln-4",
        "name": "Mukeke (Grilled Lake Tanganyika Fish)",
        "difficulty": "Medium",
        "servings": 4,
        "prepTime": 15,
        "cookTime": 20,
        "ingredients": [
          "4 whole mukeke fish (or tilapia/perch — freshwater fish)",
          "Marinade: lemon juice, garlic, salt, chili flakes",
          "Palm oil (for basting)",
          "Banana leaves (for wrapping, optional)",
          "Cassava flour (for serving as ubugari)"
        ],
        "instructions": [
          "Clean and score fish on both sides",
          "Marinate in lemon juice, garlic, salt, and chili — 30 min",
          "Baste with palm oil",
          "Grill over charcoal — the skin should blister and char",
          "Alternatively, wrap in banana leaves and grill for a smokier, steamed effect",
          "Serve with ubugari (stiff cassava porridge) and a fresh tomato-onion salad",
          "Lake Tanganyika's fish are some of the freshest in Africa — the lake is 20 minutes from Bujumbura's grills"
        ],
        "description": "Freshwater fish from Lake Tanganyika — one of the deepest, oldest lakes on Earth — grilled over charcoal and served with ubugari. Burundi's lakeside fish restaurants have become viral destinations for African food tourism content."
      }
