        "name": "Igisafuriya (Mixed Vegetable Stew)",
        "difficulty": "Easy",
        "servings": 4,
        "prepTime": 15,
        "cookTime": 30,
        "ingredients": [
          "2 plantains",
          "2 sweet potatoes",
          "1 cup beans",
          "2 tomatoes",
          "1 onion",
          "Palm oil",
          "Salt"
        ],
        "instructions": [
          "Peel and chop plantains and sweet potatoes",
          "Boil beans until almost tender",
          "Add vegetables, onion, tomatoes",
          "Cook in palm oil until soft",
          "Season with salt"
        ],
        "description": "Hearty one-pot vegetable stew."
      },
