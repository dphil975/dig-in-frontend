        "name": "Agonlin Moyo (Crab Sauce with Dough)",
        "difficulty": "Medium",
        "servings": 4,
        "prepTime": 15,
        "cookTime": 25,
        "ingredients": [
          "Live crabs (cleaned, cracked)",
          "Tomato paste",
          "Onion",
          "Palm oil",
          "Ginger",
          "Garlic",
          "Chili pepper",
          "Salt",
          "Akassa (fermented corn dough) to serve"
        ],
        "instructions": [
          "Clean and crack crabs",
          "Sauté onion, garlic, ginger in palm oil",
          "Add tomato paste, cook until oil floats",
          "Add crabs with a little water",
          "Simmer 20 min",
          "Serve sauce over akassa dough balls"
        ],
        "description": "Crab in spicy tomato-palm oil sauce — a morning meal in southern Benin's coastal towns, served with fermented corn dough."
      }
