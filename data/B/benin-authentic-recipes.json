        "name": "Ablo (Steamed Rice Cake)",
        "difficulty": "Medium",
        "servings": 6,
        "prepTime": 120,
        "cookTime": 30,
        "ingredients": [
          "2 cups rice flour",
          "1 cup water",
          "Sugar",
          "Yeast",
          "Salt"
        ],
        "instructions": [
          "Mix rice flour with water and yeast",
          "Let ferment 2 hours",
          "Add sugar and salt",
