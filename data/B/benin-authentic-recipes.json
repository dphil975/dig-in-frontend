        "name": "Sauce Graine (Palm Nut Soup)",
        "difficulty": "Medium",
        "servings": 6,
        "prepTime": 20,
        "cookTime": 60,
        "ingredients": [
          "500g palm fruit pulp (or canned palm cream)",
          "500g goat meat (cubed)",
          "Smoked fish",
          "Crab",
          "Tomato",
          "Onion",
          "Garlic",
          "Scotch bonnet pepper",
          "Salt",
          "Fufu to serve"
        ],
        "instructions": [
          "Boil palm fruit pulp, pound, extract cream",
          "Brown goat meat, set aside",
          "Sauté onion, tomato, garlic, pepper",
          "Add palm cream, bring to simmer",
          "Add goat meat, smoked fish, crab",
          "Simmer 45 min until oil rises to the surface",
          "Serve with fufu or akassa"
        ],
        "description": "Rich orange palm nut soup with mixed proteins — a celebration dish across southern Benin."
