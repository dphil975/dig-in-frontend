    {
      "id": "mor-break-msemen",
      "name": "Msemen (Moroccan Pastry)",
      "difficulty": "Hard",
      "servings": 8,
      "prepTime": 30,
      "cookTime": 30,
      "description": "Flaky Moroccan layered pastry served with honey and butter",
      "seasonings": [
        "salt"
      ],
      "ingredients": [
        "3 cups flour",
        "1 tsp salt",
        "1 cup water",
        "Butter or ghee for layers",
        "Honey",
        "Sesame seeds (optional)"
      ],
      "instructions": [
        "Make dough with flour, salt, water",
        "Knead until smooth",
        "Let rest 30 minutes",
        "Divide into 4 portions",
        "On oiled surface, stretch each thin",
        "Brush with butter",
        "Fold into square",
        "Repeat brushing and folding",
        "Pan fry on griddle until golden on both sides",
        "Serve hot with honey drizzle",
        "Sprinkle sesame seeds"
      ],
      "notes": "Requires stretching technique",
      "fun_fact": "Msemen is a Moroccan breakfast staple served at every breakfast table",
      "alternatives": [
        "Sweet filling inside",
        "Different folding method",
        "Baked instead of fried"
      ],
