      "id": "mor-lunch-tagine",
      "name": "Tagine (Slow-Cooked Stew)",
      "difficulty": "Hard",
      "servings": 6,
      "prepTime": 20,
      "cookTime": 90,
      "description": "Moroccan sweet and savory stew with meat and dried fruits",
      "seasonings": [
        "cinnamon",
        "ginger",
        "cumin",
        "saffron"
      ],
      "ingredients": [
        "2 lbs lamb, cubed",
        "2 onions, sliced",
        "4 cloves garlic",
        "3 carrots",
        "2 cups dried apricots",
        "1 cup dried prunes",
        "2 tbsp ginger",
        "1 tsp saffron",
        "1 tsp cinnamon",
        "1 tsp cumin",
        "3 cups broth",
        "2 tbsp oil",
        "Almonds",
        "Cilantro"
      ],
      "instructions": [
        "Heat oil, brown meat",
        "Sauté onions and garlic",
        "Add ginger, spices, cook 1 minute",
        "Add broth, carrots, dried fruit",
        "Bring to boil",
        "Return meat to pot",
        "Cover and simmer 60-75 minutes on low heat",
        "Meat should be tender",
        "Stir occasionally",
        "Toast almonds, sprinkle on top",
        "Garnish with cilantro"
      ],
      "notes": "Long slow cooking creates depth of flavor",
      "fun_fact": "Tagine is Morocco's national dish and refers to both the stew and the cone-shaped cooking vessel",
      "alternatives": [
        "Chicken instead of lamb",
        "Different dried fruits",
        "Vegetarian version"
      ],
