    {
      "id": "jpn-dinner-donburi",
      "name": "Katsudon (Breaded Pork Cutlet Over Rice)",
      "difficulty": "Medium",
      "servings": 2,
      "prepTime": 20,
      "cookTime": 30,
      "description": "Japanese pork cutlet over rice with egg - hearty and satisfying",
      "seasonings": [
        "soy sauce",
        "mirin",
        "dashi"
      ],
      "ingredients": [
        "2 pork cutlets (about 150g each, about 1cm thick)",
        "100g all-purpose flour",
        "2 eggs, beaten",
        "150g panko breadcrumbs",
        "2 cups cooked Japanese rice",
        "1 onion, thinly sliced",
        "2 eggs for topping",
        "For sauce: 200ml dashi stock, 3 tablespoons soy sauce, 3 tablespoons mirin, 1 tablespoon sugar",
        "Oil for frying",
        "Salt and pepper",
        "Scallions for garnish"
      ],
      "instructions": [
        "Prepare dashi sauce by simmering all sauce ingredients together, keep warm",
        "Season pork cutlets with salt and pepper",
        "Set up three bowls: flour, beaten eggs, panko breadcrumbs",
        "Coat cutlet in flour, then egg, then panko, pressing gently",
        "Heat oil in skillet to 350°F (175°C)",
        "Fry cutlets 3-4 minutes per side until golden and cooked through",
        "Drain on paper towels briefly",
        "Place warm rice in large bowls",
        "Cut cooked cutlets into strips",
        "Arrange cutlet strips on rice",
        "In small saucepan, bring dashi sauce to simmer",
        "Add sliced onions, cook 2 minutes",
        "Beat eggs lightly",
        "Slowly pour beaten eggs into simmering sauce while stirring gently",
        "Pour sauce over cutlet and rice while eggs are still slightly runny",
        "Garnish with scallions",
        "Serve immediately"
      ],
      "notes": "Eggs should be slightly runny when poured - they continue cooking with residual heat",
      "fun_fact": "Katsudon is a beloved Japanese comfort food, often eaten as quick lunch or dinner",
      "alternatives": [
        "Use chicken instead of pork",
        "Make with shrimp",
        "Add mushrooms to sauce",
        "Use different vegetables"
