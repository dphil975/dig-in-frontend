    {
      "id": "jpn-dinner-sukiyaki",
      "name": "Japanese Sukiyaki (Japanese Hot Pot with Thinly Sliced Beef)",
      "difficulty": "Medium",
      "servings": 4,
      "prepTime": 30,
      "cookTime": 20,
      "description": "Japanese hot pot with thinly sliced beef and vegetables - interactive dinner",
      "seasonings": [
        "soy sauce",
        "mirin",
        "sake"
      ],
      "ingredients": [
        "600g beef rib eye or sirloin, very thinly sliced",
        "400g extra-firm tofu, cut into cubes",
        "300g napa cabbage, cut into 5cm pieces",
        "200g shiitake mushrooms, rehydrated and halved",
        "100g enoki mushrooms",
        "4 scallions, cut into 5cm pieces",
        "4 leaves tong ho (Japanese chrysanthemum greens)",
        "100g shirataki noodles",
        "4 raw eggs (for dipping)",
        "100ml soy sauce",
        "75ml mirin",
        "60ml sake",
        "1 tablespoon brown sugar",
        "100ml dashi or beef stock"
      ],
      "instructions": [
        "Prepare warishita by mixing soy sauce, mirin, sake, brown sugar, dashi",
        "Heat shallow cast-iron sukiyaki pan or wide skillet over tabletop burner",
        "Add 1 tablespoon beef fat or oil",
        "Add several slices of beef; cook 10 seconds per side",
        "Add splash of warishita sauce",
        "Quickly add vegetables, tofu, mushrooms, noodles around beef",
        "Drizzle remaining warishita over ingredients",
        "Bring to gentle simmer; cook 5-7 minutes until vegetables tender",
        "Arrange in serving vessel at table",
        "Crack raw egg into individual dipping cups",
        "Dip cooked ingredients into raw egg before eating",
        "Continue adding more ingredients and sauce as items cook"
      ],
      "notes": "Raw egg coating (tempering) prevents salty-sweet meat from overwhelming palate",
      "fun_fact": "Traditionally dipped in raw egg for silky, rich coating",
