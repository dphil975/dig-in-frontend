      "id": "chi-break-pan-amasado",
      "name": "Pan Amasado (Chilean Bread)",
      "difficulty": "Hard",
      "servings": 8,
      "prepTime": 20,
      "cookTime": 45,
      "description": "Traditional Chilean handmade bread rolls",
      "seasonings": [
        "salt"
      ],
      "ingredients": [
        "4 cups flour",
        "1 packet yeast",
        "1.5 cups warm water",
        "2 tsp salt",
        "2 tbsp sugar",
        "2 tbsp oil",
        "Sesame seeds"
      ],
      "instructions": [
        "Mix flour, yeast, water, salt, sugar, oil",
        "Knead 10 minutes until smooth",
        "Let rise 1 hour",
        "Shape into rolls",
        "Let proof 30 minutes",
        "Brush with water",
        "Sprinkle sesame seeds",
        "Bake at 400°F for 30-35 minutes",
        "Should be golden and crusty"
      ],
      "notes": "Traditional Chilean breakfast bread",
      "fun_fact": "Pan Amasado is sold fresh daily at Chilean bakeries and street corners",
      "alternatives": [
        "Different shape",
        "Without sesame",
        "Larger loaf"
      ]
    }
  ],
