      "description": "Ethiopian spiced chicken stew",
      "seasonings": [
        "berbere spice",
        "ginger",
        "garlic"
      ],
      "ingredients": [
        "2 lbs chicken, chunked",
        "4 onions, diced",
        "4 cloves garlic, minced",
