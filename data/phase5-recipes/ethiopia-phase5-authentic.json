      "name": "Injera (Sourdough Bread)",
      "difficulty": "Hard",
      "servings": 6,
      "prepTime": 20,
      "cookTime": 60,
      "description": "Ethiopian fermented flatbread",
      "seasonings": [
        "salt"
      ],
      "ingredients": [
        "2 cups teff flour",
        "4 cups water",
        "Salt",
        "Baking soda"
      ],
      "instructions": [
        "Mix teff flour with water",
        "Let ferment 3-5 days at room temperature",
        "Mixture should smell sour",
        "Add salt and small amount baking soda",
        "Heat large non-stick skillet or crepe pan",
        "Pour thin batter",
        "Cover and cook until top is porous",
        "Don't flip",
        "Remove when top is set",
        "Cool and store"
      ],
      "notes": "Fermentation is essential",
      "fun_fact": "Injera is Ethiopia's staple bread and plate for meals",
      "alternatives": [
        "Shorter fermentation",
        "Store-bought teff",
        "Different flours"
      ]
