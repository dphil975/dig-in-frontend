        "3 tbsp berbere spice",
        "3 tbsp tomato paste",
        "2 cups broth",
        "Hard-boiled eggs",
        "Oil"
      ],
      "instructions": [
        "Sauté onions until brown",
        "Add garlic and ginger",
        "Add berbere spice, cook 2 minutes",
        "Add tomato paste",
        "Add chicken, cook 5 minutes",
        "Add broth",
        "Simmer 35 minutes until chicken is tender",
        "Add hard-boiled eggs",
        "Simmer 5 more minutes"
      ],
      "notes": "Berbere gives distinctive flavor",
      "fun_fact": "Doro Wot is Ethiopian national dish",
      "alternatives": [
        "Beef instead of chicken",
        "Vegetarian version",
        "More or less spice"
      ]
    }
  ],
