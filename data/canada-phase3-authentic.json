      "id": "can-break-poutine",
      "name": "Poutine (Fries with Gravy)",
      "difficulty": "Easy",
      "servings": 2,
      "prepTime": 10,
      "cookTime": 30,
      "description": "Canadian comfort food of crispy fries smothered in rich gravy and cheese curds",
      "seasonings": [
        "salt",
        "pepper",
        "beef broth"
      ],
      "ingredients": [
        "3 russet potatoes",
        "Oil for frying",
        "Salt",
        "3 tbsp butter",
        "3 tbsp flour",
        "2 cups beef broth",
        "1 cup cheese curds",
        "Black pepper"
      ],
      "instructions": [
        "Cut potatoes into fries",
        "Heat oil to 375°F",
        "Fry potatoes in batches until golden",
        "Drain on paper towels, season with salt",
        "Make gravy: melt butter, whisk in flour",
        "Add beef broth slowly while whisking",
        "Simmer 5 minutes until thickened",
        "Season with salt and pepper",
        "Layer fries in container",
        "Top with cheese curds",
        "Pour hot gravy over",
        "Serve immediately"
      ],
      "notes": "Gravy must be hot to slightly melt cheese curds",
      "fun_fact": "Poutine originated in Quebec and is now a Canadian icon",
