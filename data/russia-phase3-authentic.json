  "desserts": [
    {
      "id": "rus-dessert-medovik",
      "name": "Medovik (Honey Cake)",
      "difficulty": "Hard",
      "servings": 12,
      "prepTime": 45,
      "cookTime": 60,
      "description": "Russian layered honey cake with sour cream frosting",
      "seasonings": [
        "cinnamon"
      ],
      "ingredients": [
        "Layers: 1 cup honey, 1/2 cup butter, 2 eggs, 2 cups flour, 1 tsp baking soda",
        "Filling: 2 cups sour cream, 1 cup sugar, 1 tbsp gelatin",
        "Cinnamon"
      ],
      "instructions": [
        "Make dough: heat honey and butter, cool",
        "Mix with eggs, flour, baking soda",
        "Form into dough, chill",
        "Roll between parchment, cut circles",
        "Bake at 350°F for 8-10 minutes each",
        "Cool layers",
        "Make filling: dissolve gelatin, fold into sour cream and sugar",
        "Layer cakes with filling",
        "Frost entire cake with remaining filling",
        "Dust with cinnamon",
        "Refrigerate overnight"
      ],
      "notes": "Requires multiple baking stages",
      "fun_fact": "Medovik is a beloved Russian dessert often made for celebrations",
      "alternatives": [
        "Condensed milk filling",
        "Different spices",
        "Chocolate coating"
      ],
