  "dinner": [
    {
      "id": "rus-dinner-stroganoff",
      "name": "Russian Beef Stroganoff (Creamy Beef and Mushroom Sauce)",
      "difficulty": "Easy",
      "servings": 4,
      "prepTime": 20,
      "cookTime": 20,
      "description": "Creamy beef and mushroom sauce - Russian noble cuisine",
      "seasonings": [
        "paprika",
        "Dijon mustard"
      ],
      "ingredients": [
        "600g filet mignon or beef tenderloin, thinly sliced",
        "300g baby bella mushrooms, sliced",
        "2 medium white onions, thinly sliced",
        "300ml sour cream, room temperature",
        "250ml beef broth",
        "3 tablespoons butter or vegetable oil",
        "1 tablespoon Dijon mustard",
        "2 cloves garlic, minced",
        "2 tablespoons fresh dill, chopped",
        "1 tablespoon paprika",
        "Salt and white pepper to taste",
        "500g egg noodles for serving"
      ],
      "instructions": [
        "Heat 1 tablespoon butter in large skillet over medium-high heat",
        "Cook mushrooms 5 minutes until softened and moisture evaporates; set aside",
        "Add remaining butter to same skillet",
        "Cook onions until soft and golden (7-8 minutes); set aside",
        "Season beef strips with salt and white pepper",
        "Increase heat to high; working in batches, sear beef 2-3 minutes per side until just cooked but still rare inside; remove all beef",
        "Reduce heat to medium; add garlic, cook 1 minute",
        "Add paprika; cook 30 seconds",
        "Add beef broth; scrape up browned bits",
        "Return mushrooms and onions to pan",
        "Reduce heat to low",
        "In small bowl, whisk sour cream with mustard",
        "Slowly stir sour cream mixture into beef broth (do not boil or cream will curdle)",
        "Return beef to pan; stir gently to combine",
        "Simmer 5 minutes to warm through; do not boil",
        "Stir in fresh dill",
        "Taste and adjust salt and pepper",
        "Serve immediately over buttered egg noodles"
      ],
      "notes": "Do not boil sour cream or it will curdle",
      "fun_fact": "Named after wealthy Stroganov family of 19th century Russia",
      "alternatives": [
        "Use chicken",
        "Add peas",
        "Make vegetarian with mushrooms"
      ],
