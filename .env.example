# Dig In — frontend environment
#
# Copy this file to `.env` and fill in the values you need.
# All VITE_ vars are inlined at build time — do not put secrets here.

# ── Supabase Auth (required for real login) ──────────────────────────────────
# 1. Create a free project at https://supabase.com
# 2. Project Settings → API → copy "Project URL" and "anon public" key
# 3. To enable Google OAuth: Authentication → Providers → Google → enable
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Backend base URLs ─────────────────────────────────────────────────────────
#
# LOCAL DEV: leave all three EMPTY (commented out).
#   vite.config.js proxies /api/* → localhost:5000 and /food/* /badges/* → localhost:5001
#   automatically, so no env var is needed when running `npm run dev`.
#   Just start the backends:
#     cd "../Dig In-backend" && npm start          # Node backend → :5000
#     cd "../Dig In-backend/python" && python main.py  # Python service → :5001
#
# PRODUCTION: uncomment and set to your deployed service URLs.
#
# Node backend (not yet deployed):
# VITE_API_BASE=https://your-node-backend.example.com
#
# Python / Flask service — deployed to Render:
# Free tier spins down after 15 min inactivity (~30 s cold start on first request).
# Upgrade to Render Starter ($7/mo) to keep it always-on.
VITE_FLASK_BASE=https://dig-in-api.onrender.com
# VITE_PYTHON_BASE=https://dig-in-api.onrender.com   # same host as Flask

# ── OpenAI (AI Recipe Helper) ─────────────────────────────────────────────────
# 1. Go to https://platform.openai.com/api-keys and create a key
# 2. Add it here AND in Vercel Dashboard → Project → Settings → Environment Variables
# Used by api/recipe-ai.js (Vercel serverless) and api-server.js (local dev)
OPENAI_API_KEY=
