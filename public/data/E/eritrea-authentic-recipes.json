      {
        "id": "eri-ln-3",
        "name": "Zigni (Eritrean Beef Stew)",
        "difficulty": "Hard",
        "servings": 6,
        "prepTime": 20,
        "cookTime": 90,
        "ingredients": [
          "1kg beef (cubed)",
          "6 red onions (finely chopped)",
          "Berbere spice (3-4 tbsp)",
          "Niter kibbeh or tesmi (spiced butter)",
          "Tomato paste",
          "Garlic, ginger",
          "Salt",
          "Injera for serving"
        ],
        "instructions": [
          "Dry-cook chopped onions over medium heat — no oil, no water — stirring constantly for 30+ min until deeply caramelized",
          "This is the foundation — you cannot rush it, and this step makes Eritrean/Ethiopian cooking unique",
          "Add spiced butter, then berbere, fry until the oil separates",
          "Add tomato paste, garlic, ginger",
          "Add beef, stir to coat in the spice paste",
          "Add water, bring to simmer",
          "Cook covered 1-1.5 hours until beef is very tender and sauce is thick",
          "Serve on injera — communal platter, everyone eats from the same plate"
        ],
        "description": "Eritrea's beloved beef stew — built on the same dry-caramelized onion base as Ethiopian wot, but Eritreans consider their berbere spice blend distinct. The deep red sauce, fall-apart beef, and communal injera platter represent one of East Africa's great stew traditions.",
        "image": "https://upload.wikimedia.org/wikipedia/commons/2/24/Zigni.jpg",
        "imageCredit": {
          "author": "LittleT889",
          "source": "Wikimedia Commons",
          "license": "CC BY-SA 4.0",
          "url": "https://commons.wikimedia.org/wiki/File%3AZigni.jpg"
        }
      }
