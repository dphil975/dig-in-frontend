      {
        "id": "eri-bf-3",
        "name": "Ga'at (Eritrean Porridge Volcano)",
        "difficulty": "Easy",
        "servings": 4,
        "prepTime": 10,
        "cookTime": 15,
        "ingredients": [
          "2 cups barley or wheat flour",
          "Water",
          "Niter kibbeh (Eritrean spiced butter) or tesmi",
          "Berbere spice",
          "Yogurt"
        ],
        "instructions": [
          "Bring water to boil",
          "Add flour gradually, stirring vigorously with a wooden stick — one direction only",
          "Stir hard until thick, smooth, and pulling from pot",
          "Shape into a smooth dome on a plate",
          "Make a deep crater in the center — the volcano",
          "Fill the crater with melted spiced butter and berbere — the red-gold pool",
          "Surround the dome with yogurt",
          "Pull pieces from the edge, dip into the butter pool",
          "The presentation is striking — a beige mountain with a volcano of golden butter"
        ],
        "description": "Eritrea's volcano breakfast — barley porridge shaped into a dome with a crater filled with melted spiced butter and fiery berbere. Identical to Ethiopian genfo, reflecting the shared culinary heritage. The dramatic presentation and the dip-and-pull technique are viral comfort food content from the Horn of Africa.",
        "image": "https://upload.wikimedia.org/wikipedia/commons/d/d8/Ga%27at_food.jpg",
        "imageCredit": {
          "author": "Wikimedia Commons",
          "source": "Wikimedia Commons",
          "license": "CC BY-SA 4.0",
          "url": "https://upload.wikimedia.org/wikipedia/commons/d/d8/Ga%27at_food.jpg"
        }
      }
