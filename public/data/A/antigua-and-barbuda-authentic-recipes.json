  "antiguaandbarbudaRecipes": {
    "country": "Antigua and Barbuda",
    "region": "Caribbean",
    "breakfast": [
      {
        "id": "atg-bf-1",
        "name": "Saltfish and Chop-Up",
        "difficulty": "Medium",
        "servings": 4,
        "prepTime": 20,
        "cookTime": 30,
        "ingredients": [
          "300g salt cod (soaked overnight)",
          "2 cups spinach",
          "1 eggplant",
          "6 okra",
          "1 onion",
          "2 tomatoes",
          "2 tbsp butter",
          "Thyme",
          "Hot pepper sauce"
        ],
        "instructions": [
          "Boil and flake salt cod",
          "Cook spinach, eggplant, okra until soft",
          "Mash vegetables roughly",
          "Sauté onion and tomatoes in butter",
          "Add flaked fish, toss with vegetables",
          "Season with thyme and hot pepper"
        ],
        "description": "Antigua's national dish — saltfish with mashed local vegetables."
      },
      {
        "id": "atg-bf-2",
        "name": "Ducana (Sweet Potato Dumplings)",
        "difficulty": "Medium",
        "servings": 4,
        "prepTime": 25,
        "cookTime": 40,
        "ingredients": [
          "2 cups grated sweet potato",
          "1 cup grated coconut",
          "1/2 cup flour",
          "1/2 cup sugar",
          "1 tsp cinnamon",
          "Nutmeg",
          "Banana leaves"
        ],
        "instructions": [
          "Mix sweet potato, coconut, flour, sugar, spices",
          "Wrap in banana leaves, tie securely",
          "Steam 40 minutes",
          "Unwrap and serve with saltfish"
        ],
        "description": "Sweet potato dumplings steamed in banana leaves."
      },
      {
        "id": "atg-bf-3",
        "name": "Ducana (Sweet Potato Dumpling)",
        "difficulty": "Medium",
        "servings": 8,
        "prepTime": 20,
        "cookTime": 30,
        "ingredients": [
          "2 large sweet potatoes (grated)",
          "1 cup coconut (grated)",
          "1/2 cup flour",
          "1/2 cup sugar",
          "Cinnamon",
          "Nutmeg",
          "Raisins",
          "Banana leaves"
        ],
        "instructions": [
          "Mix grated sweet potato with coconut, flour, sugar, spices, raisins",
          "Wrap portions in banana leaves, tie securely",
          "Steam or boil 30 min until firm",
          "Unwrap and serve alongside saltfish"
        ],
        "description": "Sweet potato and coconut dumplings wrapped in banana leaves — always served with saltfish as Antigua's national dish."
      }
    ],
