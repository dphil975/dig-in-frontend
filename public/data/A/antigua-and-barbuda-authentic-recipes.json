        }
      },
      {
        "id": "atg-ln-3",
        "name": "Fungi and Pepperpot",
        "difficulty": "Medium",
        "servings": 4,
        "prepTime": 20,
        "cookTime": 45,
        "ingredients": [
          "Fungi: cornmeal, okra, water, butter, salt",
          "Pepperpot: spinach or amaranth leaves, eggplant, okra, squash, salted meat, onion, thyme, hot pepper"
        ],
        "instructions": [
          "Make fungi: boil okra in water, gradually add cornmeal stirring constantly until thick",
