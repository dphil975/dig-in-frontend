        }
      },
      {
        "id": "atg-ln-4",
        "name": "Fungee and Pepperpot (National Dish)",
        "difficulty": "Medium",
        "servings": 6,
        "prepTime": 20,
        "cookTime": 45,
        "ingredients": [
          "Fungee: 2 cups cornmeal, okra (sliced), water, butter, salt",
          "Pepperpot: spinach/dasheen leaves (callaloo), okra, eggplant, squash, salted meat, onion, garlic, thyme, Scotch bonnet"
        ],
        "instructions": [
          "Make pepperpot: cook salted meat until tender, add all vegetables, thyme, Scotch bonnet",
          "Simmer until vegetables are soft and meld into a thick, green, stewlike consistency",
          "For fungee: boil okra in salted water until slimy (the slime is essential)",
          "Add cornmeal gradually, stirring with a wooden cou-cou stick — circular motions only",
          "Stir vigorously — fungee must be smooth, thick, and pull away from the pot",
          "Turn out fungee onto plate as a dome",
          "Ladle pepperpot around and over the fungee",
          "This is Antigua's national dish — fungee day is Saturday, and everyone eats it"
        ],
        "description": "Antigua and Barbuda's national dish — cornmeal-and-okra fungee (similar to polenta but slimy from the okra) served with a thick vegetable pepperpot stew. The vigorous stirring technique with the cou-cou stick and the Saturday ritual have made this a viral Caribbean food tradition.",
        "image": "https://upload.wikimedia.org/wikipedia/commons/c/c2/Jerk_chicken_july_05.jpg",
        "imageCredit": {
          "author": "Wikimedia Commons",
          "source": "Wikimedia Commons",
          "license": "CC BY-SA 4.0",
          "url": "https://upload.wikimedia.org/wikipedia/commons/c/c2/Jerk_chicken_july_05.jpg"
        }
      }
