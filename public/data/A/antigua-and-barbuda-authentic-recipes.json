        "name": "Goat Water (Goat Stew)",
        "difficulty": "Hard",
        "servings": 6,
        "prepTime": 20,
        "cookTime": 120,
        "ingredients": [
          "1kg goat meat (bone-in)",
          "2 onions",
          "4 cloves",
          "Thyme",
          "Scotch bonnet pepper",
          "Tomato paste",
          "Flour dumplings",
          "Breadfruit",
          "Salt"
