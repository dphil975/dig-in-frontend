      {
        "id": "caf-dn-4",
        "name": "Gozo (Cassava Dumpling with Peanut Sauce)",
        "difficulty": "Medium",
        "servings": 4,
        "prepTime": 20,
        "cookTime": 30,
        "ingredients": [
          "Cassava flour",
          "Water",
          "Peanut sauce: ground peanuts, tomatoes, onion, garlic, palm oil, dried fish, okra",
