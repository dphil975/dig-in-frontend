      {
        "id": "cpv-ln-4",
        "name": "Cachupa Rica (Rich Cachupa)",
        "difficulty": "Hard",
        "servings": 8,
        "prepTime": 30,
        "cookTime": 180,
        "ingredients": [
          "Dried hominy corn (soaked overnight)",
          "Dried beans (butter beans and kidney beans, soaked)",
          "Pork ribs and chorizo",
          "Beef stew meat",
          "Linguiça (Portuguese sausage)",
          "Manioc, sweet potato, green banana, squash",
          "Cabbage",
          "Garlic, onion, bay leaf",
          "Salt, pepper"
        ],
        "instructions": [
