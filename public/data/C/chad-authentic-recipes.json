        "name": "Brochettes de Mouton (Grilled Lamb Skewers)",
        "difficulty": "Easy",
        "servings": 4,
        "prepTime": 15,
        "cookTime": 10,
        "ingredients": [
          "500g lamb (cubed)",
          "Yaji spice: ground peanuts, cayenne, ginger, garlic powder, onion powder, salt",
          "Onion (sliced rings)",
          "Lemon wedges",
          "Wooden skewers"
        ],
        "instructions": [
          "Cube lamb into bite-sized pieces",
          "Make yaji spice mix: grind peanuts and mix with all spices",
