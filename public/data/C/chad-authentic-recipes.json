        "name": "Sauce Gombo (Okra Sauce)",
        "difficulty": "Medium",
        "servings": 4,
        "prepTime": 15,
        "cookTime": 25,
        "ingredients": [
          "Fresh okra (sliced thin)",
          "Beef or dried fish",
          "Tomato",
          "Onion",
          "Garlic",
          "Palm oil or peanut oil",
          "Maggi cube",
          "Salt",
          "Boule (millet paste) to serve"
