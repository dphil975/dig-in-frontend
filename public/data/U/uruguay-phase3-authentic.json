      "ingredients": [
        "400g beef steak (sirloin or rib eye), thinly sliced",
        "2 crusty bread rolls or sandwich rolls",
        "100g ham, sliced",
        "100g mozzarella cheese, sliced",
        "2 eggs",
        "4 strips bacon",
        "2 tomatoes, sliced",
        "Lettuce leaves",
        "2 cloves garlic, minced",
        "2 tablespoons butter",
        "Salt and pepper to taste",
        "Mayonnaise (optional)",
        "Fried onions (optional)"
      ],
      "instructions": [
        "Cook bacon in skillet until crispy, remove and chop",
        "In same skillet, fry eggs sunny-side up, set aside",
        "Season beef slices with salt, pepper, minced garlic",
        "Heat skillet over high heat, quickly sear beef until cooked (total 2-3 minutes)",
        "Slice rolls in half",
        "Spread mayonnaise on rolls if desired",
        "Layer bottom of roll: lettuce, tomato slices, cooked beef",
        "Top with ham, mozzarella cheese, bacon pieces, fried egg",
        "Cover with top of roll",
        "Serve hot with french fries"
      ],
      "notes": "All components should be hot when assembled. Chivito is eaten for lunch or dinner",
